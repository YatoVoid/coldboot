{
  "niche": "AI and technology news explainers",
  "audience": "English-speaking US/UK tech-curious adults",
  "angle": "Explain what actually happened and why it matters, with a real opinion. Never hype, never listicle filler.",

  "source": {
    "type": "hackernews",
    "min_points": 80,
    "limit": 50
  },

  "broll_queries": [
    "server room", "data center", "circuit board", "programming code",
    "abstract technology", "city night timelapse", "robot arm",
    "network cables", "artificial intelligence", "computer chip"
  ],
  "broll_per_query": 4,

  "model": "qwen3:8b",
  "target_words": 1250,
  "videos_per_run": 6,
  "min_article_chars": 1200,
  "max_queue": 6,

  "width": 1920,
  "height": 1080,
  "fps": 30,
  "font": "auto",
  "bitrate": "5M",
  "encoder": "auto",

  "piper_voice": "en_US-ryan-high",
  "whisper_model": "base.en",
  "youtube_category": "28"
}
